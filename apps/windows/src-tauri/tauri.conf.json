{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coTs",
  "mainBinaryName": "coTsApp",
  "version": "0.6.0",
  "identifier": "com.fresnohernandez.cots",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "coTs",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Eddy Yoel Fresno Hernández",
    "shortDescription": "Notas Markdown que humanos e IAs comparten",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cots"
    ],
    "resources": {
      "resources/skill/": "skill/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
